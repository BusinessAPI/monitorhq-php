{
    "sdk": "php",
    "about": "Routes this SDK implements (METHOD + path as in the MonitorHQ routes/api.php), mapped to file#method.",
    "definition": "(?m)^\\s*public\\s+function\\s+{method}\\s*\\(",
    "operations": {
        "GET /api/v1/account": "src/Service/Account.php#get",
        "GET /api/v1/subscription": "src/Service/Subscription.php#get",
        "POST /api/v1/identifier/check": "src/Service/Identifiers.php#check",
        "GET /api/v1/monitorings": "src/Service/Monitorings.php#list",
        "POST /api/v1/monitorings": "src/Service/Monitorings.php#add",
        "POST /api/v1/monitorings/bulk": "src/Service/Monitorings.php#bulkAdd",
        "GET /api/v1/monitorings/{uuid}": "src/Service/Monitorings.php#get",
        "GET /api/v1/monitorings/{uuid}/report": "src/Service/Monitorings.php#report",
        "GET /api/v1/monitorings/{uuid}/history": "src/Service/Monitorings.php#history",
        "PUT /api/v1/monitorings/{uuid}": "src/Service/Monitorings.php#update",
        "DELETE /api/v1/monitorings/{uuid}": "src/Service/Monitorings.php#stop"
    }
}
