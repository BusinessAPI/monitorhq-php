{
    "name": "businessapi/monitorhq-php",
    "description": "PHP SDK for the MonitorHQ API: Australian company, trust, sole trader and ABN monitoring. Track ASIC, ABR, PPSR, trade mark and licence register changes, and verify webhook signatures.",
    "type": "library",
    "license": "MIT",
    "keywords": ["monitorhq", "abn", "acn", "asic", "abr", "ppsr", "monitoring", "australia", "api", "sdk", "webhooks"],
    "homepage": "https://github.com/BusinessAPI/monitorhq-php",
    "authors": [{ "name": "Business API", "email": "dev@businessapi.com.au" }],
    "support": {
        "issues": "https://github.com/BusinessAPI/monitorhq-php/issues",
        "source": "https://github.com/BusinessAPI/monitorhq-php",
        "docs": "https://monitorhq.com.au/docs",
        "security": "https://github.com/BusinessAPI/monitorhq-php/security/policy"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": { "psr-4": { "MonitorHQ\\": "src/" } },
    "autoload-dev": { "psr-4": { "MonitorHQ\\Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M"
    },
    "config": { "sort-packages": true },
    "minimum-stability": "stable"
}
